# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Port the Express API listens on inside the container (Docker maps it to localhost:3000)
PORT=3000
# Runtime mode label (development or production)
NODE_ENV=development
# Public base URL used when building embed snippets (leave unset to use the request host)
# BASE_URL=http://localhost:3000

# =============================================================================
# DATABASE CONFIGURATION (POSTGRESQL)
# docker-compose.yml sets these for the containers; they are listed here for running outside Docker
# =============================================================================
# Database host name (Docker service name 'postgres', or 'localhost' when running Node directly)
DB_HOST=postgres
# Database port
DB_PORT=5432
# Database user (must match POSTGRES_USER in docker-compose.yml)
DB_USER=postgres
# Database password (must match POSTGRES_PASSWORD in docker-compose.yml)
DB_PASSWORD=postgres
# Database name (must match POSTGRES_DB in docker-compose.yml)
DB_NAME=flyrank_db
# Optional single connection string; when set it OVERRIDES the DB_* values above, so leave it commented out for Docker
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flyrank_db

# =============================================================================
# AUTHENTICATION & WIDGET DELIVERY
# =============================================================================
# Secret used to sign login tokens; REQUIRED. Replace with a long random string and never commit your real .env
JWT_SECRET=replace_with_a_long_random_string
# How long a login token stays valid (default 1h if unset)
JWT_EXPIRES_IN=1h
# Widget bundle version; changing it changes the bundle URL (widget.v1.js -> widget.v2.js) so browsers fetch fresh code
WIDGET_VERSION=1
