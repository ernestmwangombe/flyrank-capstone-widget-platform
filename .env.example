# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Port the Express API listens on inside the container (Docker maps it to localhost:3000)
PORT=3000
# Runtime mode label (development or production)
NODE_ENV=development
# Public base URL used when building embed snippets (leave unset to use the request host)
# BASE_URL=http://localhost:3000

# =============================================================================
# DATABASE CONFIGURATION (POSTGRESQL)
# docker-compose.yml sets these for the containers; they are listed here for running outside Docker
# =============================================================================
# Database host name (Docker service name 'postgres', or 'localhost' when running Node directly)
DB_HOST=postgres
# Database port
DB_PORT=5432
# Database user (must match POSTGRES_USER in docker-compose.yml)
DB_USER=postgres
# Database password (must match POSTGRES_PASSWORD in docker-compose.yml)
DB_PASSWORD=postgres
# Database name (must match POSTGRES_DB in docker-compose.yml)
DB_NAME=flyrank_db
# Optional single connection string; when set it OVERRIDES the DB_* values above, so leave it commented out for Docker
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flyrank_db

# =============================================================================
# AUTHENTICATION & WIDGET DELIVERY
# =============================================================================
# Secret used to sign login tokens; REQUIRED. Replace with a long random string and never commit your real .env
JWT_SECRET=replace_with_a_long_random_string
# How long a login token stays valid (default 1h if unset)
JWT_EXPIRES_IN=1h
# Widget bundle version used in new embed snippets (widget.v<N>.js). Version 2 is the current loader (form + submit); version 1 is still served for old embeds.
# If you copied this file before Stage 7 and it says WIDGET_VERSION=1, change it to 2 (or delete the line).
WIDGET_VERSION=2

# =============================================================================
# STAGE 5: PROTECTION, ENRICHMENT AND SAFE SIDE EFFECTS
# =============================================================================
# Development-only test switches (headers X-Test-Geo-Down, X-Test-Notify-Fail, X-Test-Client-Ip). MUST be false in production
TEST_CONTROLS=true
# Geo lookup mode: "mock" = built-in fake providers (repeatable), "real" = ip-api.com then ipapi.co (public IP addresses only)
GEO_MODE=mock
# Maximum milliseconds to wait for each geo provider before moving on to the next one
GEO_TIMEOUT_MS=1500
# Per-IP rate limit: burst size, then tokens refilled per second (a burst above the size gets HTTP 429)
RATE_LIMIT_IP_BURST=10
RATE_LIMIT_IP_REFILL_PER_SEC=2
# Per-widget rate limit shared by all visitors of one widget
RATE_LIMIT_WIDGET_BURST=30
RATE_LIMIT_WIDGET_REFILL_PER_SEC=5
# Confirmation email: attempts before the failure alert, and the first retry delay in milliseconds (doubles each time)
NOTIFY_MAX_ATTEMPTS=3
NOTIFY_RETRY_DELAY_MS=300
